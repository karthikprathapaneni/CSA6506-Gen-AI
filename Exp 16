from transformers import BertTokenizer, GPT2Tokenizer

# Load tokenizers
bert_tokenizer = BertTokenizer.from_pretrained(
    "bert-base-uncased"
)

gpt2_tokenizer = GPT2Tokenizer.from_pretrained(
    "gpt2"
)

# Input sentence
sentence = "Artificial Intelligence is amazing."

# BERT tokenization
bert_tokens = bert_tokenizer.tokenize(sentence)

# GPT-2 tokenization
gpt2_tokens = gpt2_tokenizer.tokenize(sentence)

# Display results
print("Original Sentence:", sentence)

print("\nBERT Tokens:")
print(bert_tokens)

print("\nGPT-2 Tokens:")
print(gpt2_tokens)

print("\nComparison:")
print("BERT Token Count:", len(bert_tokens))
print("GPT-2 Token Count:", len(gpt2_tokens))
