import torch
from diffusers import StableDiffusionPipeline

def main():
    print("ENGINEERING IMAGE GENERATION")

    prompt = input("Enter image description: ")

    model_id = "runwayml/stable-diffusion-v1-5"

    device = "cuda" if torch.cuda.is_available() else "cpu"

    dtype = torch.float16 if device == "cuda" else torch.float32

    print("Loading pre-trained image generation model...")

    generator = StableDiffusionPipeline.from_pretrained(
        model_id,
        torch_dtype=dtype
    )

    generator = generator.to(device)

    print("Generating image...")

    image = generator(
        prompt,
        num_inference_steps=25
    ).images[0]

    image.save("engineering_image.png")

    print("Image generated successfully!")
    print("Saved as engineering_image.png")


if __name__ == "__main__":
    main()
