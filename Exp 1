import matplotlib.pyplot as plt

# Sample data
x = [1, 2, 3, 4, 5]
y = [10, 20, 15, 25, 30]

# Plot the line graph
plt.plot(x, y, marker='o', color='blue')

# Add labels and title
plt.xlabel("X Values")
plt.ylabel("Y Values")
plt.title("Simple Line Graph")

# Display grid and graph
plt.grid(True)
plt.show()
